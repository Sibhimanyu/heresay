# Heresay Lite: the API, dashboard and SDK as one Node server, with Firestore and Auth on the
# free Spark plan. See docs/lite.md. Build from the repo root:
#   docker build -f Dockerfile.lite -t heresay-lite .
FROM node:22-slim AS build
WORKDIR /app/functions
COPY functions/package.json functions/package-lock.json ./
RUN npm ci
COPY functions/tsconfig.json ./
COPY functions/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-slim
ENV NODE_ENV=production PORT=8080 HERESAY_TRUST_PROXY=1
WORKDIR /app
COPY public ./public
COPY --from=build /app/functions/package.json ./functions/package.json
COPY --from=build /app/functions/node_modules ./functions/node_modules
COPY --from=build /app/functions/lib ./functions/lib
USER node
EXPOSE 8080
CMD ["node", "functions/lib/providers/firebase/node-server.js"]
